{
  "name": "dsh-local-team-comment-trimming",
  "version": "0.4.4",
  "description": "团队注释规范：稀疏优先，默认可不写；注释篇幅以 chinese-writing 插件的篇幅标准为准；注释只讲本段代码、不记调用链；禁 emoji 与装饰分割线；编辑某个文件时顺手把该文件整文件清干净，另配 comment-trimmer 子代理做整目录的存量批量清理。header-comment 技能管 Java 类头 Javadoc，以及 JS、CSS、HTML、Vue 文件头的六字段注释块。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "agents",
    "cordis.patch.yml",
    ".claude-plugin",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "comments",
    "conventions",
    "java",
    "vue",
    "javascript",
    "cleanup"
  ],
  "author": {
    "name": "Himmeltala"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himmeltala/local-team.git",
    "directory": "plugins/comment-trimming"
  }
}
