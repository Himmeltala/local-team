{
  "name": "dsh-local-team-code-shaping",
  "version": "0.1.5",
  "description": "编码思维插件：写之前先找项目已有的机制与公共函数，按行业分层分包放好类和文件；只有第二处要用才抽公共函数，长函数不算问题，参数过长改为传对象，模式用来隔离变化点，同时不许过度抽象。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    ".claude-plugin",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "coding",
    "refactoring",
    "reuse",
    "abstraction",
    "design-patterns"
  ],
  "author": {
    "name": "Himmeltala"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himmeltala/local-team.git",
    "directory": "plugins/code-shaping"
  }
}
