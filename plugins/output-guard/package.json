{
  "name": "dsh-local-team-output-guard",
  "version": "0.2.0",
  "description": "AI 输出规范插件：按场景套用固定回复结构，排查与故障结论、代码改动说明、进度与结果汇报；同时约束输出侧的 token：结论先行、不复述问题、不重复粘贴文件与日志、只给相关代码片段。输入侧另有 input-guard。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    ".claude-plugin",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "reply",
    "template",
    "report",
    "troubleshooting",
    "output",
    "token"
  ],
  "author": {
    "name": "Himmeltala"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himmeltala/local-team.git",
    "directory": "plugins/output-guard"
  }
}
