{
  "description": "会话开始时注入版本控制约定；提交前拦下两种提交：svn commit（落后于服务器、有未解决冲突、前缀带范围括号）、git commit（前缀带范围括号、信息不是单行、没给信息、detached HEAD、落后或分叉于远端）",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-rules.sh\"",
            "timeout": 10,
            "statusMessage": "载入版本控制约定..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/svn-commit-guard.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-commit-guard.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
