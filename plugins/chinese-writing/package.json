{
  "name": "dsh-local-team-chinese-writing",
  "version": "0.3.7",
  "description": "中文表达与理解规范：介词、量词、关联词写全，语序按中文，术语统一，禁符号代字与翻译腔，中英混排加空格，篇幅按产出物定（回复、注释、提交信息、文档）；读中文需求遇歧义先复述确认，不按英文语序猜意图。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    ".claude-plugin",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "chinese",
    "writing",
    "documentation",
    "style"
  ],
