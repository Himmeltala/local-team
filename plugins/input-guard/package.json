{
  "name": "dsh-local-team-input-guard",
  "version": "0.1.0",
  "description": "AI 输入检查插件：用户发来任务、代码、日志、数据时，先查敏感信息并建议脱敏，再补全目标、范围、期望结果、约束与验收标准，最后从输入源头控制 token：用路径代替整文件、日志只留关键行、大任务拆小。只管输入侧，不压缩 AI 回复。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    ".claude-plugin",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "input",
    "privacy",
    "security",
    "prompt",
    "token"
  ],
  "author": {
    "name": "Himmeltala"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himmeltala/local-team.git",
    "directory": "plugins/input-guard"
  }
}
