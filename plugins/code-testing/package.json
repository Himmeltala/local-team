{
  "name": "dsh-local-team-code-testing",
  "version": "1.1.0",
  "description": "把代码测通的套路，四个技能各管一段：mock-testing 在进程外起模拟服务把链路跑通，coverage-testing 在测试代码里写假对端做端到端测试并按覆盖率补测，java-testing 记 Java 里写这类测试的 JUnit 5、surefire 与 JaCoCo 具体写法，test-reporting 负责测试用例表、测试报告与执行截图。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    ".claude-plugin",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "testing",
    "mock",
    "stub",
    "coverage",
    "jacoco",
    "junit",
    "java",
    "fault-injection",
    "test-report",
    "test-case",
    "xlsx",
    "docx",
    "screenshot"
  ],
  "author": {
    "name": "Himmeltala"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himmeltala/local-team.git",
    "directory": "plugins/code-testing"
  }
}
