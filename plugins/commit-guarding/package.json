{
  "name": "dsh-local-team-commit-guarding",
  "version": "0.4.4",
  "description": "版本控制工作流：SVN 与 git 两套提交流程的检查与硬闸门、提交信息格式、命令速查、冲突与撤销踩坑。按工作副本下有没有 .svn 或 .git 分流。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "references",
    "hooks",
    ".claude-plugin",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "git",
    "svn",
    "commit"
  ],
  "author": {
    "name": "Himmeltala"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himmeltala/local-team.git",
    "directory": "plugins/commit-guarding"
  }
}
